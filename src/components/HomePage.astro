---
// 日本語トップ（/）。英語トップはアプリ紹介のみのため EnHomePage.astro に分けている
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../i18n/ui';
import AppList from './AppList.astro';

const copy = {
  heroTitle: '業務の困りごとを、\nアプリとAIで解決します。',
  heroLead:
    '紙やExcelで回している作業のアプリ化から、生成AIの取り入れ方のご相談まで。Arrow Code Lab は、アプリ開発のご依頼とAI活用のご相談を承る個人事業です。ご相談・お見積もりは無料です。',
  heroCta: '無料で相談する',
  heroSecondary: '対応できるご相談を見る',
  servicesTitle: 'こんなご相談に対応できます',
  servicesLead:
    '要件がまとまっていない段階でも大丈夫です。小さなご依頼や、お話を聞くだけのご相談も承ります。',
  servicesExamplesLabel: 'たとえば',
  services: [
    {
      title: 'アプリ開発の受託',
      body: 'Webアプリやスマートフォンアプリを、企画の段階から一緒に考えて開発します。',
      examples: [
        '紙やExcelで管理している記録を、スマホで入力できるようにしたい',
        '毎回手作業で作っている書類を、自動で作れるようにしたい',
        '社内やお店で使う、ちょっとしたツールがほしい',
      ],
    },
    {
      title: 'AI活用のご相談',
      body: 'ChatGPT や Claude、Copilot などの生成AIを、業務にどう取り入れるかを一緒に考えます。',
      examples: [
        'どの業務にAIを使えそうか整理したい',
        'どのツールを選べばよいか、使い方も含めて相談したい',
        'AIを組み込んだツールを作りたい',
      ],
    },
  ],
  servicesNote: 'ご相談・お見積もりは無料です。料金は内容に応じて個別にお見積もりします。',
  appsTitle: '開発事例',
  appsLead:
    '自社で企画・開発しているアプリです。アイデアの整理から設計・開発、ストアでの公開の準備まで、1 人で担当しています。',
  aboutTitle: 'Arrow Code Lab について',
  aboutBody:
    'Arrow Code Lab は、本業でもソフトウェア開発の仕事をしている現役の開発者が、副業として運営している個人事業です。ご相談から設計・開発・納品まで、1 人で一貫して担当します。',
  aboutCareerTitle: '経歴',
  aboutCareer: [
    '医療系の業務システムの開発に 15 年携わっています（C#）。現在も本業で開発職として働いています。',
    '前職は金融機関に勤めていました。簿記などの知識があり、お金や帳簿にかかわる業務の流れを踏まえてお話しできます。',
    'Claude や Copilot などの生成AIを、日々の開発業務に取り入れています。',
    '自社アプリ「入居前チェック（Room Check PDF）」を、企画から開発まで 1 人で手がけ、Google Play での公開に向けて準備しています。',
  ],
  aboutSkillsTitle: '得意な技術・分野',
  aboutSkills: [
    {
      title: '業務システムの開発',
      body: 'C# による業務アプリケーションの設計・開発。現場の業務の流れに合わせた画面やデータの扱いを考えるのが得意です。',
    },
    {
      title: 'スマートフォンアプリ',
      body: 'Flutter（Dart）による Android アプリの開発。',
    },
    {
      title: '生成AIの活用',
      body: 'Claude・Copilot を使った開発の効率化や、業務への取り入れ方の検討。',
    },
    {
      title: '業務知識',
      body: '現場の業務の流れを踏まえたシステムづくりの経験と、金融機関での実務経験（簿記など）。',
    },
  ],
  aboutApproachTitle: '進め方',
  aboutApproach: [
    'ご相談の窓口から開発までを 1 人で担当するため、伝言による行き違いが起きにくくなります。',
    '要件が固まっていなくても、実現したいことを伺いながら一緒に整理します。',
    'やり取りはメールやチャットが基本です。進捗を共有しながら進めます。',
  ],
  noticeTitle: 'ご依頼の前に',
  noticeLead:
    'Arrow Code Lab は副業として運営しています。対応できる時間に限りがあるため、以下をご理解いただいたうえでご相談ください。',
  noticeItems: [
    { title: '対応時間', body: '作業やご連絡への対応は、平日の夜と土日祝日に行います。' },
    { title: 'ご返信の目安', body: 'お問い合わせには、3日以内にご返信します。' },
    {
      title: '打ち合わせ',
      body: 'メールやチャットでのやり取りを基本とします。オンラインでの打ち合わせは、平日の夜または土日祝日に調整させてください。',
    },
  ],
  noticeDeclineTitle: 'お受けできないご依頼',
  noticeDecline: [
    '平日日中の定例会議への参加や、常駐が必要なご依頼',
    '納期が短いご依頼や、大規模な開発案件',
    '24時間の障害対応や、即時の対応が必要な保守',
    '医療ソフトウェアに関するご依頼（本業と競合するため）',
  ],
  flowTitle: 'ご依頼の流れ',
  flow: [
    { title: 'お問い合わせ', body: 'フォームまたはメールでご連絡ください。' },
    { title: 'ヒアリング', body: '実現したいことや課題をお伺いします。' },
    { title: 'お見積もり・ご契約', body: '内容に応じて個別にお見積もりします。' },
    { title: '開発・ご相談対応', body: '進捗を共有しながら進めます。' },
    { title: '納品・サポート', body: '納品後の運用についてもご相談ください。' },
  ],
  flowNote: '料金は内容に応じて個別にお見積もりします。まずはお気軽にご相談ください。',
  contactTitle: 'お問い合わせ',
  contactBody:
    'アプリ開発のご依頼、AI活用のご相談、アプリに関するお問い合わせは、フォームまたはメールでご連絡ください。3日以内にご返信します。',
  contactForm: 'お問い合わせフォーム',
};
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">{copy.heroTitle}</h1>
      <p class="hero__lead">{copy.heroLead}</p>
      <div class="hero__actions">
        <a href={contact.formUrl} class="button" target="_blank" rel="noopener">{copy.heroCta} →</a>
        <a href="#services" class="button button--outline">{copy.heroSecondary} ↓</a>
      </div>
    </div>
  </section>

  <section id="services" class="section section--alt">
    <div class="container">
      <p class="section-label">Services</p>
      <h2 class="section-title">{copy.servicesTitle}</h2>
      <p class="section-lead">{copy.servicesLead}</p>
      <div class="grid">
        {
          copy.services.map((service) => (
            <div class="card">
              <h3>{service.title}</h3>
              <p class="muted">{service.body}</p>
              <p class="services__examples-label">{copy.servicesExamplesLabel}</p>
              <ul class="services__examples">
                {service.examples.map((example) => <li>{example}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="services__note">{copy.servicesNote}</p>
    </div>
  </section>

  <section id="apps" class="section">
    <div class="container">
      <p class="section-label">Apps</p>
      <h2 class="section-title">{copy.appsTitle}</h2>
      <p class="section-lead">{copy.appsLead}</p>
      <AppList lang="ja" />
    </div>
  </section>

  <section id="about" class="section section--alt">
    <div class="container">
      <p class="section-label">About</p>
      <h2 class="section-title">{copy.aboutTitle}</h2>
      <p class="section-lead">{copy.aboutBody}</p>
      <h3 class="about__heading">{copy.aboutCareerTitle}</h3>
      <ul class="about__list">
        {copy.aboutCareer.map((item) => <li>{item}</li>)}
      </ul>
      <h3 class="about__heading">{copy.aboutSkillsTitle}</h3>
      <div class="grid about__skills">
        {
          copy.aboutSkills.map((skill) => (
            <div class="card">
              <h3>{skill.title}</h3>
              <p class="muted">{skill.body}</p>
            </div>
          ))
        }
      </div>
      <h3 class="about__heading">{copy.aboutApproachTitle}</h3>
      <ul class="about__list">
        {copy.aboutApproach.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section id="flow" class="section">
    <div class="container">
      <p class="section-label">Flow</p>
      <h2 class="section-title">{copy.flowTitle}</h2>
      <ol class="flow">
        {
          copy.flow.map((step) => (
            <li class="flow__step">
              <h3>{step.title}</h3>
              <p class="muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p>{copy.flowNote}</p>
    </div>
  </section>

  <section id="notice" class="section section--alt">
    <div class="container">
      <p class="section-label">Notice</p>
      <h2 class="section-title">{copy.noticeTitle}</h2>
      <p>{copy.noticeLead}</p>
      <div class="grid notice">
        {
          copy.noticeItems.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p class="muted">{item.body}</p>
            </div>
          ))
        }
      </div>
      <h3 class="notice__decline-title">{copy.noticeDeclineTitle}</h3>
      <ul class="notice__decline">
        {copy.noticeDecline.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container contact">
      <p class="section-label">Contact</p>
      <h2 class="section-title">{copy.contactTitle}</h2>
      <p>{copy.contactBody}</p>
      <p>
        <a href={contact.formUrl} class="button" target="_blank" rel="noopener">{copy.contactForm} →</a>
      </p>
      <p class="muted">Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .card h3,
  .flow__step h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  .card p,
  .flow__step p {
    margin: 0;
  }
  .section-lead {
    margin: -1rem 0 2rem;
  }
  .card .services__examples-label {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .services__examples {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
  }
  .services__note {
    margin: 2rem 0 0;
  }
  .flow {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    padding: 0;
    margin: 0 0 2rem;
    list-style: none;
    counter-reset: step;
  }
  .flow__step {
    counter-increment: step;
    border-top: 2px solid var(--color-accent);
    padding-top: 1rem;
  }
  .flow__step::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  .about__heading {
    margin: 2.5rem 0 1rem;
    font-size: 1.125rem;
  }
  /* 4 枚が 3＋1 に割れないよう、広い画面でも 2 列にする */
  .about__skills {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .about__list {
    margin: 0;
    padding-left: 1.25rem;
  }
  .notice {
    margin-block: 2rem;
  }
  .notice__decline-title {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
  }
  .notice__decline {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>

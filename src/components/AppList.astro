---
import { Image } from 'astro:assets';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getApps, slugOf } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const apps = await getApps(lang);
---

{
  apps.length === 0 ? (
    <p class="muted">{t('apps.empty')}</p>
  ) : (
    <div class="grid">
      {apps.map((app) => (
        <a href={localizePath(`/apps/${slugOf(app)}/`, lang)} class="card app-card">
          <div class="app-card__header">
            {app.data.icon && (
              <Image src={app.data.icon} alt="" width={56} height={56} densities={[1, 2]} class="app-card__icon" />
            )}
            <div>
              <span class="app-card__status">{t(`apps.status.${app.data.status}`)}</span>
              <h3>{app.data.title}</h3>
            </div>
          </div>
          <p class="muted">{app.data.description}</p>
          {app.data.screenshots.length > 0 && (
            <div class="app-card__shots">
              {app.data.screenshots.slice(0, 3).map((shot) => (
                <Image src={shot.src} alt={shot.caption} width={120} densities={[1, 2]} loading="lazy" />
              ))}
            </div>
          )}
          {app.data.tech.length > 0 && (
            <dl class="app-card__meta">
              <dt>{t('apps.tech')}</dt>
              <dd>
                <ul class="tags">
                  {app.data.tech.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
              {app.data.role && (
                <>
                  <dt>{t('apps.role')}</dt>
                  <dd>{app.data.role}</dd>
                </>
              )}
            </dl>
          )}
        </a>
      ))}
    </div>
  )
}

<style>
  .app-card {
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .app-card:hover {
    border-color: var(--color-accent);
  }
  .app-card h3 {
    margin: 0;
    font-size: 1.125rem;
  }
  .app-card p {
    margin: 0;
  }
  .app-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .app-card__icon {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 22%;
  }
  /* カードだけで画面の雰囲気が伝わるよう、先頭の数枚を並べる */
  .app-card__shots {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .app-card__shots img {
    width: 7.5rem;
    min-width: 0;
    flex: 0 1 auto;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }
  .app-card__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
  }
  .app-card__meta dt {
    font-weight: 600;
    color: var(--color-accent);
  }
  .app-card__meta dd {
    margin: 0;
  }
  .app-card__status {
    display: inline-block;
    margin-bottom: 0.25rem;
    padding: 0 0.625rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
